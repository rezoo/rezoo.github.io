---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign last_date = page.last_modified_at | default: page.last_updated %}

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post blog-post">
  <header class="post-header">
    <div class="post-header-inner">
      <div class="post-meta-row">
        <p class="post-meta">
          作成日: {{ page.date | date: '%Y年%-m月%-d日' }}
          {% if page.author %}・著者: {{ page.author }}{% endif %}
          {% if last_date %}・最終更新日: {{ last_date | date: '%Y年%-m月%-d日' }}{% endif %}
          {% if page.meta %}・{{ page.meta }}{% endif %}
        </p>
        <span class="post-divider" aria-hidden="true"></span>
        <p class="post-tags">
          <a href="{{ year | prepend: '/blog/' | append: '/' | relative_url }}">
            <i class="fa-solid fa-calendar fa-sm"></i>
            {{ year }}
          </a>
          {% if tags != '' %}
            &nbsp; &middot; &nbsp;
            {% for tag in page.tags %}
              <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">
                <i class="fa-solid fa-hashtag fa-sm"></i>
                {{ tag }}
              </a>
              {% unless forloop.last %}&nbsp;{% endunless %}
            {% endfor %}
          {% endif %}
          {% if categories != '' %}
            &nbsp; &middot; &nbsp;
            {% for category in page.categories %}
              <a href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">
                <i class="fa-solid fa-tag fa-sm"></i>
                {{ category }}
              </a>
              {% unless forloop.last %}&nbsp;{% endunless %}
            {% endfor %}
          {% endif %}
        </p>
      </div>
      <h1 class="post-title">{{ page.title }}</h1>
    </div>
  </header>

  <article class="post-content">
    <div id="markdown-content">{{ content }}</div>
  </article>
</div>
