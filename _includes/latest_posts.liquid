{% assign latest_posts_size = site.posts | size %}
{% assign latest_posts_limit = page.latest_posts.limit | default: latest_posts_size %}
<ul class="latest-posts">
  {% for item in site.posts limit: latest_posts_limit %}
    <li>
      <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%Y年%-m月%-d日' }}</time>
      <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
    </li>
  {% endfor %}
</ul>
