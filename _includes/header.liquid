<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% unless page.permalink == '/' %}
        <a class="navbar-brand title" href="{{ '/' | relative_url }}">
          <span class="nav-monogram">
            <img src="{{ '/assets/img/angel-icon.svg' | relative_url | bust_file_cache }}" alt="" width="32" height="32">
          </span>
          <span class="brand-name">
            <strong>{{ site.first_name }}</strong>
            {{ site.last_name }}
          </span>
        </a>
      {% endunless %}

      <ul class="navbar-nav navbar-menu-list flex-nowrap">
        <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
          <a class="nav-link" href="{{ '/' | relative_url }}">
            about
            {% if page.permalink == '/' -%}
              <span class="sr-only">(current)</span>
            {%- endif %}
          </a>
        </li>
        <li class="nav-item {% if page.url contains '/blog/' %}active{% endif %}">
          <a class="nav-link" href="{{ '/blog/' | relative_url }}">
            blog
            {% if page.url contains '/blog/' -%}
              <span class="sr-only">(current)</span>
            {%- endif %}
          </a>
        </li>
        {% if site.enable_darkmode %}
          <li class="toggle-container">
            <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
              <i class="fa-half-sun-moon" id="light-toggle-system"></i>
              <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
              <i class="fa-solid fa-sun" id="light-toggle-light"></i>
            </button>
          </li>
        {% endif %}
      </ul>
    </div>
  </nav>

  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
